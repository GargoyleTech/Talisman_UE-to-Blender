{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "1.0",
  "FriendlyName": "Niagara Reflection Dump",
  "Description": "Read-only diagnostic plugin that writes reflected Niagara property schemas when launched with -NiagaraReflectionDump.",
  "Category": "Diagnostics",
