  "Plugins": [
    { "Name": "Niagara", "Enabled": true },
    { "Name": "VFXNiagara", "Enabled": true }
  ],
  "Modules": [
    {
      "Name": "NiagaraReflectionDump",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    }
  ]
}
